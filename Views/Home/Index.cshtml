@model IEnumerable<KutuphaneSistemi.Models.Book>

@{
    ViewData["Title"] = "Ana Sayfa";
    var kapakRenkleri = new[] { "bg-primary", "bg-success", "bg-danger", "bg-warning" };
    int kapakSay = 0;
}

<!-- ============================================================
     HERO BOLUMU  (tam genislik - CSS breakout teknigi)
     ============================================================ -->
<div class="hero-bolum">
    <div class="hero-overlay"></div>
    <div class="hero-icerik">
        <h1><i class="bi bi-book-half me-3"></i>Kütüphane Otomasyon Sistemi</h1>
        <p>Kitapları, yazarları ve kategorileri kolayca yönetin.</p>
        <div>
            <a asp-controller="Books" asp-action="Index" class="btn btn-light btn-lg">
                <i class="bi bi-book me-2"></i>Kitaplar
            </a>
            <a asp-controller="Authors" asp-action="Index" class="btn btn-outline-light btn-lg">
                <i class="bi bi-person-lines-fill me-2"></i>Yazarlar
            </a>
            <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-light btn-lg">
                <i class="bi bi-tags me-2"></i>Kategoriler
            </a>
        </div>
    </div>
</div>

<!-- ============================================================
     İSTATİSTİK KARTLARI
     ============================================================ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg">
        <div class="stat-kart card text-center">
            <div class="card-body">
                <span class="stat-ikon text-primary"><i class="bi bi-book-half"></i></span>
                <div class="stat-sayi text-primary">@ViewBag.ToplamKitap</div>
                <div class="stat-etiket">Toplam Kitap</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="stat-kart card text-center">
            <div class="card-body">
                <span class="stat-ikon text-success"><i class="bi bi-person-lines-fill"></i></span>
                <div class="stat-sayi text-success">@ViewBag.ToplamYazar</div>
                <div class="stat-etiket">Toplam Yazar</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="stat-kart card text-center">
            <div class="card-body">
                <span class="stat-ikon text-warning"><i class="bi bi-tags"></i></span>
                <div class="stat-sayi text-warning">@ViewBag.ToplamKategori</div>
                <div class="stat-etiket">Toplam Kategori</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6 col-lg">
        <div class="stat-kart card text-center">
            <div class="card-body">
                <span class="stat-ikon text-success"><i class="bi bi-check-circle-fill"></i></span>
                <div class="stat-sayi text-success">@ViewBag.MüsaitKitap</div>
                <div class="stat-etiket">Rafta Olan</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg">
        <div class="stat-kart card text-center">
            <div class="card-body">
                <span class="stat-ikon text-danger"><i class="bi bi-x-circle-fill"></i></span>
                <div class="stat-sayi text-danger">@ViewBag.MüsaitDegilKitap</div>
                <div class="stat-etiket">Ödünçte Olan</div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     ÖNE ÇIKAN KİTAPLAR
     ============================================================ -->
<div class="bolum-baslik">
    <i class="bi bi-star-fill"></i> Öne Çıkan Kitaplar
</div>

@if (ViewBag.OncuKitaplar != null)
{
    var oncuKitaplar = (IEnumerable<KutuphaneSistemi.Models.Book>)ViewBag.OncuKitaplar;
    <div class="row g-3 mb-4">
        @foreach (var kitap in oncuKitaplar)
        {
            <div class="col-6 col-md-3">
                <div class="kitap-kart card">
                    <div class="kitap-kapak @kapakRenkleri[kapakSay % 4]">
                        <i class="bi bi-book-fill"></i>
                    </div>
                    <div class="card-body">
                        <div class="card-title">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@kitap.Id"
                               class="text-decoration-none text-dark">@kitap.Title</a>
                        </div>
                        <p class="card-text">
                            <small><i class="bi bi-person me-1"></i>@kitap.Author?.FullName</small>
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary rounded-pill" style="font-size:0.72rem;">
                                @kitap.Category?.Name
                            </span>
                            @if (kitap.IsAvailable)
                            {
                                <span class="badge bg-success" style="font-size:0.72rem;">Müsait</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" style="font-size:0.72rem;">Ödünçte</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            kapakSay++;
        }
    </div>
}

<!-- ============================================================
     KÜTÜPhANE HAKKINDA BİLGİ
     ============================================================ -->
<div class="bilgi-bolum mb-4">
    <div class="row align-items-center">
        <div class="col-md-3 text-center mb-3 mb-md-0">
            <i class="bi bi-building bi-lg bilgi-ikon"></i>
        </div>
        <div class="col-md-9">
            <h4 class="fw-bold mb-2">
                <i class="bi bi-info-circle text-primary me-2"></i>Sistem Hakkında
            </h4>
            <p class="mb-2 text-muted">
                Kütüphane Otomasyon Sistemi, kitapları, yazarları ve kategorileri yönetmek için
                geliştirilmiş bir <strong>ASP.NET Core MVC</strong> uygulamasıdır.
            </p>
            <ul class="mb-0 text-muted" style="font-size:0.92rem;">
                <li>Kitap ekleme, düzenleme ve silme işlemleri</li>
                <li>Yazar ve kategori yönetimi</li>
                <li>Kitap arama ve filtreleme</li>
                <li>Müsaitlik durumu takibi</li>
            </ul>
        </div>
    </div>
</div>

<!-- ============================================================
     SON EKLENEN KİTAPLAR
     ============================================================ -->
<div class="bolum-baslik">
    <i class="bi bi-clock-history"></i> Son Eklenen Kitaplar
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Henüz kitap eklenmemiş.
    </div>
}
else
{
    <div class="tablo-kap">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead>
                    <tr>
                        <th>Kitap Adı</th>
                        <th>Yazar</th>
                        <th>Kategori</th>
                        <th>Yayın Yılı</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kitap in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Books" asp-action="Details"
                                   asp-route-id="@kitap.Id"
                                   class="text-decoration-none fw-semibold">
                                    @kitap.Title
                                </a>
                            </td>
                            <td>@kitap.Author?.FullName</td>
                            <td>
                                <span class="badge bg-secondary rounded-pill">@kitap.Category?.Name</span>
                            </td>
                            <td>@kitap.PublicationYear</td>
                            <td>
                                @if (kitap.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Müsait
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>Ödünçte
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-2 mb-3">
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-list-ul me-2"></i>Tüm Kitapları Görüntüle
        </a>
    </div>
}
