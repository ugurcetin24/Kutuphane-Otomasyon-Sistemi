@model KutuphaneSistemi.Models.Book

@{
    ViewData["Title"] = "Kitap Sil";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🗑️ Kitap Sil</h2>
    <a asp-action="Index" class="btn btn-secondary">← Listeye Dön</a>
</div>

<div class="alert alert-warning">
    <strong>Dikkat!</strong> Bu kitabı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Silinecek Kitap Bilgileri</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Kitap Adı</dt>
            <dd class="col-sm-9 fw-bold">@Model.Title</dd>

            <dt class="col-sm-3">Yazar</dt>
            <dd class="col-sm-9">@Model.Author?.FullName</dd>

            <dt class="col-sm-3">Kategori</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@(Model.ISBN ?? "-")</dd>

            <dt class="col-sm-3">Yayın Yılı</dt>
            <dd class="col-sm-9">@(Model.PublicationYear?.ToString() ?? "-")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Evet, Sil</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Vazgeç</a>
        </form>
    </div>
</div>
