@model KutuphaneSistemi.Models.Book

@{
    ViewData["Title"] = "Kitap Düzenle";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>✏️ Kitap Düzenle</h2>
    <a asp-action="Index" class="btn btn-secondary">← Listeye Dön</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ISBN" class="form-label fw-semibold"></label>
                    <input asp-for="ISBN" class="form-control" />
                    <span asp-validation-for="ISBN" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AuthorId" class="form-label fw-semibold"></label>
                    <select asp-for="AuthorId" asp-items="ViewBag.AuthorId" class="form-select">
                        <option value="">-- Yazar Seçin --</option>
                    </select>
                    <span asp-validation-for="AuthorId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                        <option value="">-- Kategori Seçin --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PublicationYear" class="form-label fw-semibold"></label>
                    <input asp-for="PublicationYear" class="form-control" />
                    <span asp-validation-for="PublicationYear" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PageCount" class="form-label fw-semibold"></label>
                    <input asp-for="PageCount" class="form-control" />
                    <span asp-validation-for="PageCount" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ShelfLocation" class="form-label fw-semibold"></label>
                    <input asp-for="ShelfLocation" class="form-control" />
                    <span asp-validation-for="ShelfLocation" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Kitap Durumu</label>
                    <div class="form-check mt-2">
                        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="IsAvailable" class="form-check-label">Kitap Müsait</label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-warning">💾 Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
