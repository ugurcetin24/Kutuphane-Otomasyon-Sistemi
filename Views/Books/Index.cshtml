@model IEnumerable<KutuphaneSistemi.Models.Book>

@{
    ViewData["Title"] = "Kitaplar";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-2">
    <h2 class="fw-bold mb-0"><i class="bi bi-book me-2 text-primary"></i>Kitap Listesi</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Yeni Kitap Ekle
    </a>
</div>

<!-- Arama ve Filtreleme -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Kitap Adı Ara</label>
                <input type="text" name="aramaMetni" value="@ViewBag.AramaMetni"
                       class="form-control" placeholder="Kitap adı yazın..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Kategoriye Göre</label>
                <select name="kategoriId" class="form-select">
                    <option value="">-- Tüm Kategoriler --</option>
                    @foreach (var kat in (IEnumerable<KutuphaneSistemi.Models.Category>)ViewBag.Kategoriler)
                    {
                        if (ViewBag.SecilenKategori != null && ViewBag.SecilenKategori == kat.Id)
                        {
                            <option value="@kat.Id" selected>@kat.Name</option>
                        }
                        else
                        {
                            <option value="@kat.Id">@kat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Yazara Göre</label>
                <select name="yazarId" class="form-select">
                    <option value="">-- Tüm Yazarlar --</option>
                    @foreach (var yazar in (IEnumerable<KutuphaneSistemi.Models.Author>)ViewBag.Yazarlar)
                    {
                        if (ViewBag.SecilenYazar != null && ViewBag.SecilenYazar == yazar.Id)
                        {
                            <option value="@yazar.Id" selected>@yazar.FullName</option>
                        }
                        else
                        {
                            <option value="@yazar.Id">@yazar.FullName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Filtrele
                </button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.AramaMetni as string) || ViewBag.SecilenKategori != null || ViewBag.SecilenYazar != null)
        {
            <div class="mt-2">
                <span class="badge bg-secondary">@ViewBag.SonucSayisi sonuç bulundu</span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">
                    <i class="bi bi-x-circle me-1"></i>Filtreyi Temizle
                </a>
            </div>
        }
    </div>
</div>

<!-- Kitap Tablosu -->
@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>
            <strong>Bilgi:</strong> Gösterilecek kitap bulunamadı.
            @if (string.IsNullOrEmpty(ViewBag.AramaMetni as string) && ViewBag.SecilenKategori == null && ViewBag.SecilenYazar == null)
            {
                <a asp-action="Create" class="ms-1">İlk kitabı ekleyin.</a>
            }
        </div>
    </div>
}
else
{
    <div class="tablo-kap">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead>
                    <tr>
                        <th><i class="bi bi-book me-1"></i>Kitap Adı</th>
                        <th><i class="bi bi-person me-1"></i>Yazar</th>
                        <th><i class="bi bi-tag me-1"></i>Kategori</th>
                        <th>ISBN</th>
                        <th>Yayın Yılı</th>
                        <th>Sayfa</th>
                        <th>Raf</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kitap in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@kitap.Title</td>
                            <td>@kitap.Author?.FullName</td>
                            <td>
                                <span class="badge bg-secondary rounded-pill">@kitap.Category?.Name</span>
                            </td>
                            <td><small class="text-muted">@(kitap.ISBN ?? "—")</small></td>
                            <td>@(kitap.PublicationYear?.ToString() ?? "—")</td>
                            <td>@(kitap.PageCount?.ToString() ?? "—")</td>
                            <td><code>@(kitap.ShelfLocation ?? "—")</code></td>
                            <td>
                                @if (kitap.IsAvailable)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Müsait
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>Ödünçte
                                    </span>
                                }
                            </td>
                            <td style="white-space:nowrap">
                                <a asp-action="Details" asp-route-id="@kitap.Id"
                                   class="btn btn-sm btn-outline-info btn-islem">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@kitap.Id"
                                   class="btn btn-sm btn-outline-warning btn-islem">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@kitap.Id"
                                   class="btn btn-sm btn-outline-danger btn-islem">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-2 text-muted small">
            <i class="bi bi-list-check me-1"></i>Toplam <strong>@Model.Count()</strong> kitap listeleniyor.
        </div>
    </div>
}
