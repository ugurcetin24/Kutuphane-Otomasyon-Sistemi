@model IEnumerable<KutuphaneSistemi.Models.Book>

@{
    ViewData["Title"] = "Kitaplar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📖 Kitap Listesi</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kitap Ekle</a>
</div>

<!-- Arama ve Filtreleme Formu -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Kitap Adı Ara</label>
                <input type="text" name="aramaMetni" value="@ViewBag.AramaMetni"
                       class="form-control" placeholder="Kitap adı yazın..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Kategoriye Göre</label>
                <select name="kategoriId" class="form-select">
                    <option value="">-- Tüm Kategoriler --</option>
                    @foreach (var kat in (IEnumerable<KutuphaneSistemi.Models.Category>)ViewBag.Kategoriler)
                    {
                        if (ViewBag.SecilenKategori != null && ViewBag.SecilenKategori == kat.Id)
                        {
                            <option value="@kat.Id" selected>@kat.Name</option>
                        }
                        else
                        {
                            <option value="@kat.Id">@kat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Yazara Göre</label>
                <select name="yazarId" class="form-select">
                    <option value="">-- Tüm Yazarlar --</option>
                    @foreach (var yazar in (IEnumerable<KutuphaneSistemi.Models.Author>)ViewBag.Yazarlar)
                    {
                        if (ViewBag.SecilenYazar != null && ViewBag.SecilenYazar == yazar.Id)
                        {
                            <option value="@yazar.Id" selected>@yazar.FullName</option>
                        }
                        else
                        {
                            <option value="@yazar.Id">@yazar.FullName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filtrele</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(ViewBag.AramaMetni as string) || ViewBag.SecilenKategori != null || ViewBag.SecilenYazar != null)
        {
            <div class="mt-2">
                <span class="badge bg-secondary">@ViewBag.SonucSayisi sonuç bulundu</span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2">Filtreyi Temizle</a>
            </div>
        }
    </div>
</div>

<!-- Kitap Tablosu -->
@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>Bilgi:</strong> Gösterilecek kitap bulunamadı.
        @if (string.IsNullOrEmpty(ViewBag.AramaMetni as string) && ViewBag.SecilenKategori == null && ViewBag.SecilenYazar == null)
        {
            <a asp-action="Create">İlk kitabı ekleyin.</a>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead>
                <tr>
                    <th>Kitap Adı</th>
                    <th>Yazar</th>
                    <th>Kategori</th>
                    <th>Yayın Yılı</th>
                    <th>Sayfa</th>
                    <th>Raf</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kitap in Model)
                {
                    <tr>
                        <td class="fw-semibold">@kitap.Title</td>
                        <td>@kitap.Author?.FullName</td>
                        <td>@kitap.Category?.Name</td>
                        <td>@kitap.PublicationYear</td>
                        <td>@kitap.PageCount</td>
                        <td>@kitap.ShelfLocation</td>
                        <td>
                            @if (kitap.IsAvailable)
                            {
                                <span class="badge bg-success">Müsait</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ödünçte</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@kitap.Id" class="btn btn-sm btn-info text-white">Detay</a>
                            <a asp-action="Edit" asp-route-id="@kitap.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@kitap.Id" class="btn btn-sm btn-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
