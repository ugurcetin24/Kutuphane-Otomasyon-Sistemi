@model IEnumerable<KutuphaneSistemi.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🏷️ Kategori Listesi</h2>
    <a asp-action="Create" class="btn btn-warning">+ Yeni Kategori Ekle</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>Bilgi:</strong> Henüz kategori eklenmemiş.
        <a asp-action="Create">İlk kategoriyi ekleyin.</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead>
                <tr>
                    <th>Kategori Adı</th>
                    <th>Açıklama</th>
                    <th>Kitap Sayısı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kategori in Model)
                {
                    <tr>
                        <td class="fw-semibold">@kategori.Name</td>
                        <td>@(kategori.Description ?? "-")</td>
                        <td>
                            <span class="badge bg-warning text-dark rounded-pill">@kategori.Books.Count</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@kategori.Id" class="btn btn-sm btn-info text-white">Detay</a>
                            <a asp-action="Edit" asp-route-id="@kategori.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@kategori.Id" class="btn btn-sm btn-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
