<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kütüphane Otomasyon Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var aktifController = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2"></i>Kütüphane Sistemi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(aktifController == "Home" ? "aktif-link" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(aktifController == "Books" ? "aktif-link" : "")"
                               asp-controller="Books" asp-action="Index">
                                <i class="bi bi-book me-1"></i>Kitaplar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(aktifController == "Authors" ? "aktif-link" : "")"
                               asp-controller="Authors" asp-action="Index">
                                <i class="bi bi-person-lines-fill me-1"></i>Yazarlar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(aktifController == "Categories" ? "aktif-link" : "")"
                               asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags me-1"></i>Kategoriler
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">

            @* Başarı mesajı *@
            @if (TempData["Basari"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Basari"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* Hata mesajı *@
            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Hata"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            <div class="row align-items-center py-1">
                <div class="col-md-6 text-center text-md-start mb-1 mb-md-0">
                    <i class="bi bi-book-half me-2"></i>
                    <strong>Kütüphane Otomasyon Sistemi</strong>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small>ASP.NET Core MVC Okul Projesi &copy; 2026</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
