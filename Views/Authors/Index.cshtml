@model IEnumerable<KutuphaneSistemi.Models.Author>

@{
    ViewData["Title"] = "Yazarlar";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-2">
    <h2 class="fw-bold mb-0"><i class="bi bi-person-lines-fill me-2 text-success"></i>Yazar Listesi</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>Yeni Yazar Ekle
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
        <div>
            <strong>Bilgi:</strong> Henüz yazar eklenmemiş.
            <a asp-action="Create" class="ms-1">İlk yazarı ekleyin.</a>
        </div>
    </div>
}
else
{
    <div class="tablo-kap">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead>
                    <tr>
                        <th><i class="bi bi-person me-1"></i>Ad Soyad</th>
                        <th><i class="bi bi-globe me-1"></i>Ülke</th>
                        <th><i class="bi bi-calendar me-1"></i>Doğum Yılı</th>
                        <th><i class="bi bi-book me-1"></i>Kitap Sayısı</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var yazar in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@yazar.FullName</td>
                            <td>
                                <i class="bi bi-geo-alt text-muted me-1"></i>
                                @(yazar.Country ?? "—")
                            </td>
                            <td>@(yazar.BirthYear?.ToString() ?? "—")</td>
                            <td>
                                <span class="badge bg-primary rounded-pill fs-6 px-3">
                                    @yazar.Books.Count
                                </span>
                            </td>
                            <td style="white-space:nowrap">
                                <a asp-action="Details" asp-route-id="@yazar.Id"
                                   class="btn btn-sm btn-outline-info btn-islem">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@yazar.Id"
                                   class="btn btn-sm btn-outline-warning btn-islem">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@yazar.Id"
                                   class="btn btn-sm btn-outline-danger btn-islem">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-2 text-muted small">
            <i class="bi bi-list-check me-1"></i>Toplam <strong>@Model.Count()</strong> yazar listeleniyor.
        </div>
    </div>
}
